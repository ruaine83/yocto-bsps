#!/usr/bin/env bash

set -e
set -o pipefail

source ./scripts/sources/helper_functions

# Define global variables
OE_BUILD_DIR=""
PYREX_BIND=""
TARGET_BUILD_MODE=""
TARGET_PRODUCT=""
TARGET_IMAGE=""

# Use local build directory for the BSP build for speed and space.

# NOTE: All of these directories must be defined with absolute paths.
# Otherwise whisk and bitbake will complain
LOCAL_BUILD_DIR="/opt/bsp/build"
REPO_BUILD_LINK_NAME="${PWD}/build"

TOP_ARTIFACTS_DIR="${PWD}/artifacts"


setup_venv() {

    local REQS_FILE=${1:-"./whisk/requirements.txt"}
    local SETUP_FILE=${2:-"./whisk/setup-venv"}

    sudo apt install -y python3.12-venv python3-git
    # pip3 install --user virtualenv --break-system-packages
    # pip3 install --user gitpython --break-system-packages
    # sed -i -e 's/python3 -m venv "venv"/python3 -m virtualenv "venv"/g' "${SETUP_FILE}"
    ./whisk/setup-venv
    source whisk/venv/bin/activate
}

setup_dirs() {
    if [ ! -d ${REPO_BUILD_LINK_NAME} ]; then
        echo "Creating link to easily monitor build directory..."
        ln -s "${LOCAL_BUILD_DIR}" "${REPO_BUILD_LINK_NAME}"
    fi

    if [ ! -d "${LOCAL_BUILD_DIR}" ]; then
        echo "Build directory does not exist. Exiting..."
        exit 1
    fi

    if [ ! -d "${TOP_ARTIFACTS_DIR}" ]; then
        mkdir -p "${TOP_ARTIFACTS_DIR}"
    fi

    export OE_BUILD_DIR="${LOCAL_BUILD_DIR}"
    export PYREX_BIND="${OE_BUILD_DIR}"
}

get_build_parameters() {


    #TARGET_BUILD_MODE=$(user_input "build mode" "development" "production" "release")
    TARGET_BUILD_MODE="release"
    TARGET_PRODUCT=$(user_input "target product" "pr-beaglev" "pr-raspberrypi0" "pr-raspberrypi3" "pr-raspberrypi4" "pr-raspberrypi5" "raspberrypi4")
    TARGET_IMAGE="scarthgap"
    CLEAN_TARGETS=$(user_input_list "target recipes to clean")
    #TARGET_IMAGE=$(user_input "target image version" "scarthgap" "wrynose" )

echo -e "\n\nSelected ${TARGET_PRODUCT} with ${TARGET_BUILD_MODE} image of ${TARGET_IMAGE}\n\n"
}

build_bsp() {
    . ./init-build-env --product "${TARGET_PRODUCT}" --mode "${TARGET_BUILD_MODE}" --version "${TARGET_IMAGE}" --build-dir "${OE_BUILD_DIR}"

    
    if [[ ${#CLEAN_TARGETS[@]} -gt 0 ]]; then
        local target_list=""
        for target in "${CLEAN_TARGETS[@]}"; do
            target_list+="mc:product-${TARGET_PRODUCT}:${target} "
        done

        echo "Cleaning targets: ${CLEAN_TARGETS[@]}"
        bitbake -c cleansstate $target_list
        bitbake -c cleanall $target_list
    fi

    bitbake mc:product-${TARGET_PRODUCT}:core-image-full-cmdline
}

copy_artifacts() {
    local ARTIFACTS_DIR="${TOP_ARTIFACTS_DIR}/${TARGET_IMAGE}/${TARGET_PRODUCT}"

    if [ ! -d "$ARTIFACTS_DIR" ]; then
        mkdir -p "$ARTIFACTS_DIR"
    fi

    cp -r "${OE_BUILD_DIR}/tmp/deploy/images/${TARGET_PRODUCT}/"*.wic.gz "$ARTIFACTS_DIR/" || true
    cp -r "${OE_BUILD_DIR}/tmp/deploy/images/${TARGET_PRODUCT}/"*.bmap "$ARTIFACTS_DIR/" || true
}

cleanup() {
    # Clear Bitbake Variables
    unset BB_ENV_EXTRAWHITE

    # Clear Environment Variables
    unset OE_BUILD_DIR
    unset PYREX_BIND

    deactivate
}

main() {

    setup_venv "$@"
    setup_dirs
    get_build_parameters
    build_bsp
    cleanup
}

main "$@"